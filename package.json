    "type": "git",
    "url": "git+https://github.com/windowkit/appkit.git"
  },
  "bugs": {
    "url": "https://github.com/windowkit/appkit/issues"
  },
  "keywords": [
    "macos",
    "appkit",
    "core-animation",
    "calayer",
    "coretext",
    "iosurface",
    "nsmenu",
    "native-controls",
    "react-x11",
    "windowkit"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "LICENSE",
    "index.js",
